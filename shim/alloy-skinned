#!/usr/bin/env bash
# Start Alloy with the skin. Undo: start ~/Applications/Alloy.AppImage directly.
export LD_PRELOAD="$HOME/.local/lib/alloy-skin/alloyskin.so${LD_PRELOAD:+:$LD_PRELOAD}"
export ALLOY_SKIN_CSS="${ALLOY_SKIN_CSS:-$HOME/.config/alloy-skin/skin.css}"
export ALLOY_SKIN_JS="$HOME/.config/alloy-skin/skin.js${ALLOY_SKIN_JS:+:$ALLOY_SKIN_JS}"
# Minecraft gets the NVIDIA GPU while the launcher window stays on the integrated one.
# Empty this to let the game follow whatever environment Alloy was started with.
export ALLOY_SKIN_GAME_ENV="__NV_PRIME_RENDER_OFFLOAD=1;__GLX_VENDOR_LIBRARY_NAME=nvidia;VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/nvidia_icd.json"

exec "$HOME/Applications/Alloy.AppImage" "$@"
